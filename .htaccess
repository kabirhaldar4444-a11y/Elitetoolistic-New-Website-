RewriteEngine On
RewriteBase /

# 1. API Route: Send /api/checkout to api/checkout.php on cPanel/Apache
RewriteRule ^api/checkout/?$ api/checkout.php [L,QSA]

# 2. Allow direct access to existing files & folders (dist, images, css, js)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 3. React SPA Fallback: Send all other routes to index.html
RewriteRule ^ index.html [L]
